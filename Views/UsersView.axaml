<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Planilla_RRHH.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Planilla_RRHH.Views.UsersView"
             x:DataType="vm:UsersViewModel">

    <Design.DataContext>
        <vm:UsersViewModel />
    </Design.DataContext>

    <Grid Margin="24" RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <TextBlock Text="Gestión de usuarios"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Administre cuentas de acceso y roles del sistema"
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Nuevo usuario"
                    Command="{Binding AddUserCommand}"
                    IsEnabled="{Binding CanManageUsers}"
                    Height="40"
                    Padding="20,0"
                    FontSize="14"
                    FontWeight="Medium"
                    Classes="accent"
                    VerticalAlignment="Bottom" />
        </Grid>

        <!-- Users Grid -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="*, Auto">
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Users}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="2*" />
                        <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="2*" />
                        <DataGridTextColumn Header="Rol" Binding="{Binding RoleName}" Width="150" />
                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding IsActive, Converter={StaticResource ActiveToColor}}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource ActiveToText}}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Acciones" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Button Content="Editar"
                                                Command="{Binding $parent[DataGrid].((vm:UsersViewModel)DataContext).EditUserCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding $parent[DataGrid].((vm:UsersViewModel)DataContext).CanManageUsers}"
                                                MinWidth="64" Height="40"
                                                Padding="8,4"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                ToolTip.Tip="Editar" />
                                        <Button Content="Clave"
                                                Command="{Binding $parent[DataGrid].((vm:UsersViewModel)DataContext).ResetPasswordCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding $parent[DataGrid].((vm:UsersViewModel)DataContext).CanManageUsers}"
                                                MinWidth="64" Height="40"
                                                Padding="8,4"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                ToolTip.Tip="Restablecer contraseña" />
                                        <Button Content="{Binding IsActive, Converter={StaticResource ToggleButtonText}}"
                                                Command="{Binding $parent[DataGrid].((vm:UsersViewModel)DataContext).ToggleActiveCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding $parent[DataGrid].((vm:UsersViewModel)DataContext).CanManageUsers}"
                                                MinWidth="64" Height="40"
                                                Padding="8,4"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                ToolTip.Tip="{Binding IsActive, Converter={StaticResource ToggleTooltip}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="0"
                           Text="No hay usuarios registrados"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="16"
                           IsVisible="{Binding Users.Count, Converter={StaticResource IsZero}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>